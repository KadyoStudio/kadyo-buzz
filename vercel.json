{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/telegram.js": { "maxDuration": 300, "includeFiles": "assets/**" },
    "api/publication.js": { "maxDuration": 300, "includeFiles": "calendar.json" },
    "api/cron/frequent.js": { "maxDuration": 800, "includeFiles": "{assets/**,calendar.json}" },
    "api/cron/morning.js": { "maxDuration": 600, "includeFiles": "calendar.json" }
  },
  "crons": [
    { "path": "/api/cron/frequent", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/morning", "schedule": "0 6,7 * * *" }
  ]
}
